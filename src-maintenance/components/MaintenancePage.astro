---
// メンテナンス中画面。deploy.yml の MAINTENANCE_WINDOW が true のときは、
// 本サイトの代わりにこの 1 ページだけを astro.maintenance.config.ts でビルドして配信する。
// ナビやフッターはリンク先がビルドに含まれないので出さない。
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../../src/styles/global.css';
import { locales } from '../../src/i18n/config';
import { t } from '../../src/i18n/ui';

const siteTitle = t('ja', 'site.title');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={t('ja', 'maintenance.title')} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-white">
    <main class="container-site flex min-h-screen flex-col items-center justify-center py-16 text-center">
      <p class="text-h1 font-bold text-black" lang="en">{siteTitle}</p>
      {
        locales.map((locale) => (
          <section lang={locale} class="mt-10">
            <h1 class="text-h2">{t(locale, 'maintenance.title')}</h1>
            <p class="mx-auto mt-4 max-w-2xl text-lg text-body">{t(locale, 'maintenance.body')}</p>
          </section>
        ))
      }
    </main>
  </body>
</html>
