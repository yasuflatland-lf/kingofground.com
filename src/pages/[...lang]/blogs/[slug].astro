---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../components/PageHeader.astro';
import { formatDate } from '../../../i18n/format';
import { t } from '../../../i18n/ui';
import { localePaths, localeStaticPaths } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogs, getBlogTranslations } from '../../../lib/collections';
import { availableLocales, splitId } from '../../../lib/content';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) => {
      const entries = await getBlogs(props.locale);
      return Promise.all(
        entries.map(async (entry) => {
          const { slug } = splitId(entry.id);
          const path = `/blogs/${slug}/`;
          const found = await getBlogTranslations(slug);
          const translations = localePaths(availableLocales(found), path);
          return {
            params: { ...params, slug },
            props: { locale: props.locale, entry, translations },
          };
        }),
      );
    }),
  );
  return perLocale.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, entry, translations } = Astro.props as Props;

const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  translations={translations}
  fallbackPath="/blogs/"
>
  <article>
    <PageHeader locale={locale} title={entry.data.title} date={entry.data.pubDate} size="h2" />
    <div class="container-site pb-16">
      {
        entry.data.updatedDate && (
          <p class="mb-6 font-ui text-sm text-medium">
            {t(locale, 'meta.updated')}: {formatDate(entry.data.updatedDate, locale)}
          </p>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
