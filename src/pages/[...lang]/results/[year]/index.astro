---
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { formatDate } from '../../../../i18n/format';
import { t } from '../../../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../../../i18n/utils';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getResultsByYear, getResultYearLocales, getStandings } from '../../../../lib/collections';
import { resultParts, splitId } from '../../../../lib/content';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) => {
      const years = await getResultsByYear(props.locale);
      return Promise.all(
        years.map(async ({ year, results }) => {
          const path = `/results/${year}/`;
          const translations = localePaths(await getResultYearLocales(year), path);
          const hasStandings = (await getStandings(props.locale, year)) !== undefined;
          return {
            params: { ...params, year: String(year) },
            props: { locale: props.locale, year, results, translations, hasStandings },
          };
        }),
      );
    }),
  );
  return perLocale.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, year, results, translations, hasStandings } = Astro.props as Props;

// 大会名の「KING OF GROUND 2025 ROUND 1」に合わせて、年のページは「KING OF GROUND 2025」
const title = `${t(locale, 'site.title')} ${year}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={t(locale, 'results.description')}
  translations={translations}
  fallbackPath="/results/"
>
  <PageHeader
    locale={locale}
    title={title}
    titleLang="en"
    kicker={{ label: t(locale, 'results.title'), href: localePath(locale, '/results/') }}
  />
  <div class="container-site pb-16">
    <ul class="mx-auto mt-16 max-w-4xl divide-y divide-soft">
      {
        results.map((entry) => (
          <li>
            <a
              href={localePath(locale, `/results/${splitId(entry.id).slug}/`)}
              class="group block py-6"
            >
              <h2 class="text-h2 group-hover:underline" lang="en">
                {t(locale, 'results.round')} {resultParts(entry.id).round}
              </h2>
              {entry.data.venue && <p class="mt-2 text-body">{entry.data.venue}</p>}
              <time datetime={entry.data.date.toISOString()} class="mt-3 block text-xs text-medium">
                {formatDate(entry.data.date, locale)}
              </time>
            </a>
          </li>
        ))
      }
      {
        hasStandings && (
          <li>
            <a
              href={localePath(locale, `/results/${year}/standings/`)}
              class="group block py-6"
            >
              <h2 class="text-h2 group-hover:underline">{t(locale, 'results.standings')}</h2>
            </a>
          </li>
        )
      }
    </ul>
  </div>
</BaseLayout>
