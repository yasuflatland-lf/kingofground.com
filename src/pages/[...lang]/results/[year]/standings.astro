---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../../components/PageHeader.astro';
import ResultsTable from '../../../../components/ResultsTable.astro';
import { t } from '../../../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../../../i18n/utils';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getAllStandings, getStandingsLocales } from '../../../../lib/collections';
import { standingsYear } from '../../../../lib/content';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) => {
      const entries = await getAllStandings(props.locale);
      return Promise.all(
        entries.map(async (entry) => {
          const year = standingsYear(entry.id);
          const path = `/results/${year}/standings/`;
          const translations = localePaths(await getStandingsLocales(year), path);
          return {
            params: { ...params, year: String(year) },
            props: { locale: props.locale, entry, year, translations },
          };
        }),
      );
    }),
  );
  return perLocale.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, entry, year, translations } = Astro.props as Props;

const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  translations={translations}
  fallbackPath="/results/"
>
  <article>
    <PageHeader
      locale={locale}
      title={entry.data.title}
      description={entry.data.description}
      kicker={{
        label: `${t(locale, 'site.title')} ${year}`,
        href: localePath(locale, `/results/${year}/`),
        lang: 'en',
      }}
      titleLang="en"
    />
    <div class="container-site pb-16">
      <div class="mx-auto mt-16 max-w-2xl">
        {
          entry.body && (
            <div class="prose">
              <Content />
            </div>
          )
        }
        <div class={entry.body ? 'mt-10' : undefined}>
          {
            entry.data.classes.map((cls) => (
              <ResultsTable locale={locale} name={cls.name} placements={cls.placements} />
            ))
          }
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
