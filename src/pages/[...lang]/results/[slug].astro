---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../components/PageHeader.astro';
import ResultsTable from '../../../components/ResultsTable.astro';
import { t } from '../../../i18n/ui';
import { localePaths, localeStaticPaths } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getResults, getResultTranslations } from '../../../lib/collections';
import { availableLocales, splitId } from '../../../lib/content';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) => {
      const entries = await getResults(props.locale);
      return Promise.all(
        entries.map(async (entry) => {
          const { slug } = splitId(entry.id);
          const path = `/results/${slug}/`;
          const found = await getResultTranslations(slug);
          const translations = localePaths(availableLocales(found), path);
          return {
            params: { ...params, slug },
            props: { locale: props.locale, entry, translations },
          };
        }),
      );
    }),
  );
  return perLocale.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, entry, translations } = Astro.props as Props;

const { Content } = await render(entry);
const venue = entry.data.venue ? `${t(locale, 'results.venue')}: ${entry.data.venue}` : undefined;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={venue ?? entry.data.title}
  translations={translations}
  fallbackPath="/results/"
>
  <article>
    <PageHeader
      locale={locale}
      title={entry.data.title}
      description={venue}
      date={entry.data.date}
      titleLang="en"
    />
    <div class="container-site">
      <div class="mx-auto max-w-3xl">
        {
          entry.data.classes.map((cls) => (
            <ResultsTable locale={locale} name={cls.name} placements={cls.placements} />
          ))
        }
        {
          entry.body && (
            <div class="prose mt-10">
              <Content />
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
