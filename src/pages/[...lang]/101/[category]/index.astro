---
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { t } from '../../../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../../../i18n/utils';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getGuideCategoriesFor, getGuideCategoryLocales } from '../../../../lib/collections';
import { splitId } from '../../../../lib/content';

export async function getStaticPaths() {
  const perLocale = await Promise.all(
    localeStaticPaths().map(async ({ params, props }) => {
      const groups = await getGuideCategoriesFor(props.locale);
      return Promise.all(
        groups.map(async ({ category, guides }) => {
          const path = `/101/${category.id}/`;
          const translations = localePaths(await getGuideCategoryLocales(category.id), path);
          return {
            params: { ...params, category: category.id },
            props: { locale: props.locale, category, guides, translations },
          };
        }),
      );
    }),
  );
  return perLocale.flat();
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, category, guides, translations } = Astro.props as Props;
---

<BaseLayout
  locale={locale}
  title={category.data.title[locale]}
  description={category.data.description[locale]}
  translations={translations}
  fallbackPath="/101/"
>
  <PageHeader
    locale={locale}
    title={category.data.title[locale]}
    description={category.data.description[locale]}
    kicker={{ label: t(locale, 'guides.title'), href: localePath(locale, '/101/') }}
  />
  <div class="container-site">
    <ul class="mx-auto mt-16 max-w-4xl divide-y divide-soft">
      {
        guides.map((guide) => (
          <li>
            <a href={localePath(locale, `/101/${splitId(guide.id).slug}/`)} class="group block py-4">
              <span class="block text-h3 font-bold text-black group-hover:underline">
                {guide.data.title}
              </span>
              <span class="mt-1 block text-medium">{guide.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
