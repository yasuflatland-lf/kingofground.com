---
import type { InferGetStaticPropsType } from 'astro';
import PageHeader from '../../../components/PageHeader.astro';
import { locales } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getGuideCategoriesFor } from '../../../lib/collections';
import { splitId } from '../../../lib/content';

export const getStaticPaths = () => localeStaticPaths();

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props as Props;

const groups = await getGuideCategoriesFor(locale);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'guides.title')}
  description={t(locale, 'guides.description')}
  translations={localePaths(locales, '/101/')}
  fallbackPath="/101/"
>
  <PageHeader
    locale={locale}
    title={t(locale, 'guides.title')}
    description={t(locale, 'guides.description')}
    titleLang="en"
  />
  <div class="container-site">
    {
      groups.map(({ category, guides }) => (
        <section class="mx-auto mt-16 max-w-4xl">
          <h2 class="text-h3">
            <a
              href={localePath(locale, `/101/${category.id}/`)}
              class="inline-flex items-center py-2.5 -my-2.5 hover:underline"
            >
              {category.data.title[locale]}
            </a>
          </h2>
          <p class="mt-2 text-medium">{category.data.description[locale]}</p>
          <ul class="mt-6 divide-y divide-soft">
            {guides.map((guide) => (
              <li>
                <a
                  href={localePath(locale, `/101/${splitId(guide.id).slug}/`)}
                  class="group block py-4"
                >
                  <span class="text-h6 font-semibold text-black group-hover:underline">
                    {guide.data.title}
                  </span>
                  <span class="text-medium"> — {guide.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
