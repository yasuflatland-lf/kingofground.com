---
import type { InferGetStaticPropsType } from 'astro';
import CtaBox from '../../components/CtaBox.astro';
import EntryList from '../../components/EntryList.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Hero from '../../components/Hero.astro';
import { locales } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogs, getResults } from '../../lib/collections';
import { splitId } from '../../lib/content';

export const getStaticPaths = () => localeStaticPaths();

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props as Props;

const blogs = (await getBlogs(locale)).slice(0, 3);
const results = (await getResults(locale)).slice(0, 3);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'site.title')}
  description={t(locale, 'site.tagline')}
  translations={localePaths(locales, '/')}
>
  <Hero locale={locale} />
  <FeatureGrid locale={locale} />

  <section class="container-site mt-20">
    <div class="mx-auto flex max-w-4xl items-baseline justify-between gap-4">
      <h2 class="text-h2">{t(locale, 'home.latestBlogs')}</h2>
      <a href={localePath(locale, '/blogs/')} class="text-link inline-flex min-h-11 items-center">{t(locale, 'home.viewAll')}</a>
    </div>
    <EntryList
      locale={locale}
      items={blogs.map((entry) => ({
        title: entry.data.title,
        date: entry.data.pubDate,
        description: entry.data.description,
        href: localePath(locale, `/blogs/${splitId(entry.id).slug}/`),
      }))}
    />
  </section>

  <section class="container-site mt-20">
    <div class="mx-auto flex max-w-4xl items-baseline justify-between gap-4">
      <h2 class="text-h2">{t(locale, 'home.latestResults')}</h2>
      <a href={localePath(locale, '/results/')} class="text-link inline-flex min-h-11 items-center">{t(locale, 'home.viewAll')}</a>
    </div>
    <EntryList
      locale={locale}
      items={results.map((entry) => ({
        title: entry.data.title,
        date: entry.data.date,
        description: entry.data.venue,
        href: localePath(locale, `/results/${splitId(entry.id).slug}/`),
        lang: 'en',
      }))}
    />
  </section>

  <CtaBox locale={locale} />
</BaseLayout>
