---
import type { InferGetStaticPropsType } from 'astro';
import EntryList from '../../components/EntryList.astro';
import { locales } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { localePath, localePaths, localeStaticPaths } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogs, getResults } from '../../lib/collections';
import { splitId } from '../../lib/content';

export const getStaticPaths = () => localeStaticPaths();

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props as Props;

const blogs = (await getBlogs(locale)).slice(0, 3);
const results = (await getResults(locale)).slice(0, 3);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'site.title')}
  description={t(locale, 'site.tagline')}
  translations={localePaths(locales, '/')}
>
  <section class="bg-black text-white">
    <div class="container-site py-16 lg:py-24">
      <h1 class="text-display text-white" lang="en">KING OF GROUND</h1>
      <p class="mt-6 font-ui text-lg text-silver">{t(locale, 'site.tagline')}</p>
    </div>
  </section>

  <section class="container-site py-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-h3">{t(locale, 'home.latestBlogs')}</h2>
      <a href={localePath(locale, '/blogs/')} class="text-btn">{t(locale, 'home.viewAll')}</a>
    </div>
    <EntryList
      locale={locale}
      items={blogs.map((entry) => ({
        title: entry.data.title,
        date: entry.data.pubDate,
        description: entry.data.description,
        href: localePath(locale, `/blogs/${splitId(entry.id).slug}/`),
      }))}
    />
  </section>

  <section class="container-site pb-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-h3">{t(locale, 'home.latestResults')}</h2>
      <a href={localePath(locale, '/results/')} class="text-btn">{t(locale, 'home.viewAll')}</a>
    </div>
    <EntryList
      locale={locale}
      items={results.map((entry) => ({
        title: entry.data.title,
        date: entry.data.date,
        description: entry.data.venue,
        href: localePath(locale, `/results/${splitId(entry.id).slug}/`),
      }))}
    />
  </section>

  <section class="container-site grid gap-4 pb-16 md:grid-cols-2">
    <a href={localePath(locale, '/101/')} class="btn">{t(locale, 'home.guidesLead')}</a>
    <a href={localePath(locale, '/history/')} class="btn">{t(locale, 'home.historyLead')}</a>
  </section>
</BaseLayout>
