---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="bg-highlight py-16">
  <div class="container-site">
    <div class="mx-auto flex max-w-5xl flex-col items-center text-center">
      <h2 class="text-h2 font-normal">{t(locale, 'home.ctaTitle')}</h2>
      <p class="mt-4 text-lg text-ink">{t(locale, 'home.ctaBody')}</p>
      <a href={localePath(locale, '/101/')} class="btn mt-8">{t(locale, 'home.ctaButton')}</a>
    </div>
  </div>
</section>
