---
import type { Locale } from '../i18n/config';
import { t, type UiKey } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// アイコンは 24×24 の stroke パス（時計 / トロフィー / 開いた本）
const features: Array<{ title: UiKey; body: UiKey; path: string; icon: string }> = [
  {
    title: 'home.feature.history.title',
    body: 'home.feature.history.body',
    path: '/history/',
    icon: 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  {
    title: 'home.feature.results.title',
    body: 'home.feature.results.body',
    path: '/results/',
    icon: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3',
  },
  {
    title: 'home.feature.guides.title',
    body: 'home.feature.guides.body',
    path: '/101/',
    icon: 'M12 6.5A4 4 0 0 0 8 4H3v14h5a4 4 0 0 1 4 2 4 4 0 0 1 4-2h5V4h-5a4 4 0 0 0-4 2.5ZM12 6.5V20',
  },
];
---

<section class="bg-off-white py-10 md:py-16">
  <div class="container-site">
    <h2 class="text-h2">{t(locale, 'home.featuresTitle')}</h2>
    <p class="mt-4 max-w-3xl text-body">{t(locale, 'home.featuresLead')}</p>
    <ul class="mt-16 grid gap-x-10 gap-y-16 md:grid-cols-3">
      {
        features.map((feature) => (
          <li class="flex items-start gap-4">
            <span class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-black text-white">
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={feature.icon} />
              </svg>
            </span>
            <div>
              <h3 class="text-h3">
                <a
                  href={localePath(locale, feature.path)}
                  class="inline-flex items-center py-2.5 -my-2.5 hover:underline"
                >
                  {t(locale, feature.title)}
                </a>
              </h3>
              <p class="mt-2 text-body">{t(locale, feature.body)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
