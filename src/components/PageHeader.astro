---
import type { Locale } from '../i18n/config';
import { formatDate } from '../i18n/format';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  date?: Date;
  /** タイトルの上に置く小さなラベル。親セクションへのリンクを兼ねる */
  kicker?: { label: string; href: string; lang?: 'en' };
  titleLang?: 'en';
}

const { locale, title, description, date, kicker, titleLang } = Astro.props;
---

<header class="container-site mt-16 text-center">
  {
    kicker && (
      <p class="kicker">
        <a
          href={kicker.href}
          class="inline-flex min-h-11 items-center hover:underline"
          lang={kicker.lang}
        >
          {kicker.label}
        </a>
      </p>
    )
  }
  <h1 class:list={['text-h1', kicker && 'mt-2']} lang={titleLang}>{title}</h1>
  {description && <p class="mx-auto mt-4 max-w-2xl text-balance text-body">{description}</p>}
  {
    date && (
      <time datetime={date.toISOString()} class="mt-3 block text-xs text-medium">
        {formatDate(date, locale)}
      </time>
    )
  }
</header>
