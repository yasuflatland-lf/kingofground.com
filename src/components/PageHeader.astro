---
import type { Locale } from '../i18n/config';
import { formatDate } from '../i18n/format';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  date?: Date;
  size?: 'h1' | 'h2';
  titleLang?: 'en';
}

const { locale, title, description, date, size = 'h1', titleLang } = Astro.props;
const sizeClass = size === 'h2' ? 'text-h2' : 'text-h1';
---

<header class="container-site pt-16 pb-10">
  {
    date && (
      <time datetime={date.toISOString()} class="font-ui text-sm text-medium">
        {formatDate(date, locale)}
      </time>
    )
  }
  <h1 class:list={[sizeClass, 'mt-2']} lang={titleLang}>{title}</h1>
  {description && <p class="mt-4 max-w-prose text-lg">{description}</p>}
</header>
