---
import type { Locale } from '../i18n/config';
import { formatDate } from '../i18n/format';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  date?: Date;
  /** タイトルの上に置く小さなラベル（Astroship のブログのカテゴリ表示に相当）。親セクションへのリンクを兼ねる */
  kicker?: { label: string; href: string };
  titleLang?: 'en';
}

const { locale, title, description, date, kicker, titleLang } = Astro.props;
---

<header class="container-site mt-16 text-center">
  {
    kicker && (
      <p class="kicker">
        <a href={kicker.href} class="hover:underline">
          {kicker.label}
        </a>
      </p>
    )
  }
  <h1 class:list={['text-h2', kicker && 'mt-2']} lang={titleLang}>{title}</h1>
  {description && <p class="mx-auto mt-2 max-w-2xl text-lg text-medium">{description}</p>}
  {
    date && (
      <time datetime={date.toISOString()} class="mt-3 block text-sm text-medium">
        {formatDate(date, locale)}
      </time>
    )
  }
</header>
