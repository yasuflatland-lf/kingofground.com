---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="container-site mt-20 mb-10 text-center text-sm text-medium">
  <p>{t(locale, 'footer.copyright')} {year}</p>
  <p class="mt-1 text-xs">{t(locale, 'site.tagline')}</p>
</footer>
