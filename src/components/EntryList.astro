---
import type { Locale } from '../i18n/config';
import { formatDate } from '../i18n/format';

interface EntryListItem {
  title: string;
  date: Date;
  description?: string;
  href: string;
  lang?: 'en';
}

interface Props {
  locale: Locale;
  items: EntryListItem[];
  headingLevel?: 'h2' | 'h3';
}

const { locale, items, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="mx-auto mt-16 grid max-w-4xl gap-16">
  {
    items.map((item) => (
      <li>
        <a href={item.href} class="group grid items-center gap-5 md:grid-cols-2 md:gap-10">
          {/* スキーマに画像が無いあいだのプレースホルダー面。画像を足したらここを <Image> にする */}
          <div
            class="flex aspect-video w-full items-center justify-center rounded-md border border-soft"
            aria-hidden="true"
          >
            <span lang="en" class="text-h3 font-bold text-medium">
              KOG
            </span>
          </div>
          <div>
            <Heading class="text-h3 group-hover:underline" lang={item.lang}>
              {item.title}
            </Heading>
            {item.description && <p class="mt-2 text-body">{item.description}</p>}
            <time datetime={item.date.toISOString()} class="mt-3 block text-sm text-medium">
              {formatDate(item.date, locale)}
            </time>
          </div>
        </a>
      </li>
    ))
  }
</ul>
