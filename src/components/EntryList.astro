---
import type { Locale } from '../i18n/config';
import { formatDate } from '../i18n/format';

export interface EntryListItem {
  title: string;
  date: Date;
  description?: string;
  href: string;
}

interface Props {
  locale: Locale;
  items: EntryListItem[];
}

const { locale, items } = Astro.props;
---

<ul class="divide-y divide-soft">
  {
    items.map((item) => (
      <li class="py-6">
        <a href={item.href} class="group block">
          <time datetime={item.date.toISOString()} class="font-ui text-sm text-medium">
            {formatDate(item.date, locale)}
          </time>
          <h3 class="text-h6 mt-1 group-hover:underline">{item.title}</h3>
          {item.description && <p class="mt-2">{item.description}</p>}
        </a>
      </li>
    ))
  }
</ul>
