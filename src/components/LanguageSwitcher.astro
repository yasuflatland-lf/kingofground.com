---
import { type Locale, locales } from '../i18n/config';
import { t } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  translations: Partial<Record<Locale, string>>;
  fallbackPath?: string;
}

const { locale, translations, fallbackPath = '/' } = Astro.props;

// config の順（ja, en）で全ロケールを並べる。現在地はリンクにしない
const segments = locales.map((target) => ({
  locale: target,
  current: target === locale,
  href: translations[target] ?? localePath(target, fallbackPath),
  code: t(target, 'lang.code'),
  name: t(target, 'lang.name'),
}));
---

<ul class="lang-switch" aria-label={t(locale, 'lang.switcher')}>
  {
    segments.map((segment) => (
      <li>
        {segment.current ? (
          <span class="lang-switch-item" aria-current="page" aria-label={segment.name}>
            {segment.code}
          </span>
        ) : (
          <a
            href={segment.href}
            hreflang={segment.locale}
            lang={segment.locale}
            data-locale={segment.locale}
            aria-label={segment.name}
            class="lang-switch-item"
          >
            {segment.code}
          </a>
        )}
      </li>
    ))
  }
</ul>
