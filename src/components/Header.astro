---
import type { Locale } from '../i18n/config';
import { t, type UiKey } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  translations: Partial<Record<Locale, string>>;
  fallbackPath: string;
}

const { locale, translations, fallbackPath } = Astro.props;

const nav: Array<{ key: UiKey; path: string }> = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.history', path: '/history/' },
  { key: 'nav.blogs', path: '/blogs/' },
  { key: 'nav.results', path: '/results/' },
];

// 現在ページ: ホームは完全一致、それ以外はセクションの前方一致
const pathname = Astro.url.pathname;
function isCurrent(path: string): boolean {
  const href = localePath(locale, path);
  return path === '/' ? pathname === href : pathname.startsWith(href);
}
---

{/* センチネルが画面から出たら（40px スクロールしたら）header に data-stuck が付く */}
<div data-header-sentinel class="pointer-events-none absolute top-0 h-10 w-full" aria-hidden="true"></div>
<header
  class="site-header group sticky top-0 z-10 max-h-dvh overflow-y-auto bg-white data-stuck:bg-black"
>
  <div class="container-site flex flex-col items-center py-3 lg:flex-row">
    <div class="flex w-full items-center justify-between lg:w-auto">
      <a
        href={localePath(locale, '/')}
        lang="en"
        class="text-black group-data-stuck:text-white"
      >
        <span class="font-bold">KING</span><span class="text-medium group-data-stuck:text-soft"> OF GROUND</span>
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-label={t(locale, 'nav.toggle')}
        aria-expanded="false"
        aria-controls="site-nav"
        class="flex size-11 items-center justify-center text-black group-data-stuck:text-white lg:hidden"
      >
        <svg
          data-icon="open"
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          data-icon="close"
          class="hidden size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div
      id="site-nav"
      class="mt-3 hidden w-full flex-col items-center gap-3 lg:mt-0 lg:flex lg:w-auto lg:flex-1 lg:flex-row lg:gap-0"
    >
      <nav aria-label="main" class="w-full lg:mx-auto lg:w-auto">
        <ul class="flex flex-col items-center lg:flex-row lg:gap-1">
          {
            nav.map(({ key, path }) => (
              <li>
                <a
                  href={localePath(locale, path)}
                  class="nav-link"
                  aria-current={isCurrent(path) ? 'page' : undefined}
                >
                  {t(locale, key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguageSwitcher locale={locale} translations={translations} fallbackPath={fallbackPath} />
    </div>
  </div>
  <noscript>
    <style is:inline>
      #site-nav {
        display: flex;
      }
      .site-header {
        border-bottom: 1px solid var(--color-soft);
      }
      @media (width < 64.0625rem) {
        .site-header {
          position: static;
        }
      }
    </style>
  </noscript>
</header>

<script>
  import { bindNavToggle, observeStuck } from '../scripts/header';

  const header = document.querySelector<HTMLElement>('.site-header');
  const sentinel = document.querySelector('[data-header-sentinel]');
  if (header && sentinel) observeStuck(header, sentinel);

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) bindNavToggle(toggle, nav);
</script>
