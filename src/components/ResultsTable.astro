---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  name: string;
  placements: Array<{ rank: number; rider: string; points?: number }>;
}

const { locale, name, placements } = Astro.props;

// ポイントを持つのは年間ランキングだけ。ラウンドのリザルトは順位とライダー名の 2 列
const showPoints = placements.some((placement) => placement.points !== undefined);
---

<section class="mt-10 first:mt-0">
  <h2 class="text-h3" lang="en">{name}</h2>
  <table class="mt-4 w-full border-collapse text-left">
    <thead>
      <tr class="border-b border-soft text-xs text-medium">
        <th class="w-20 py-2 pr-4 font-normal">{t(locale, 'results.rank')}</th>
        <th class="py-2 font-normal">{t(locale, 'results.rider')}</th>
        {
          showPoints && (
            <th class="w-24 py-2 pl-4 text-right font-normal">{t(locale, 'results.points')}</th>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        placements.map((placement) => (
          <tr class="border-b border-soft even:bg-off-white">
            <td class="py-3 pr-4 font-bold text-black">{placement.rank}</td>
            <td class="py-3 text-black">{placement.rider}</td>
            {showPoints && (
              <td class="py-3 pl-4 text-right text-black">{placement.points}</td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
